# Everything here is optional. The editor works with no configuration.
# Total running cost: $0. No accounts, API keys or subscriptions are needed.

PORT=8787
HOST=0.0.0.0
# Where projects, uploads, exports and the Whisper model cache are stored (default: ./data)
# DATA_DIR=/path/to/storage
# Largest upload accepted, in MB (default 20 GB)
MAX_UPLOAD_MB=20480
# Concurrent FFmpeg jobs. Rendering is CPU-bound; 1 is right for most computers.
RENDER_CONCURRENCY=1
# x264 speed/quality trade-off: ultrafast … fast (default) … medium … slow
X264_PRESET=fast

# Free local speech recognition (open-source Whisper).
# "small" = best accuracy (241 MB one-time download), "base" = faster (76 MB).
WHISPER_MODEL=small
# WHISPER_CACHE_DIR=/path/to/models

# Protect the editor with a password (HTTP Basic auth) if other people can
# reach your computer on the network.
# APP_PASSWORD=
