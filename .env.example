# Server
PORT=8787
HOST=0.0.0.0
# Where projects, uploads and exports are stored (default: ./data)
# DATA_DIR=/var/lib/premium-studio
MAX_UPLOAD_MB=4096
# Concurrent FFmpeg jobs. Rendering is CPU-bound; 1 is right for most machines.
RENDER_CONCURRENCY=1
# x264 speed/quality trade-off: ultrafast … medium (default) … slow
X264_PRESET=medium
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# Protect the whole app with a password (HTTP Basic auth). Set this whenever
# the server is reachable by anyone else: transcription spends Deepgram credit.
# APP_PASSWORD=

# --- Stage 2 · Automatic subtitles (Deepgram) ---
# Server-side only: never put this in frontend code. The browser never sees it.
# Get a key at https://console.deepgram.com (new accounts: $200 free credit).
# DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3

# --- Stage 3 · AI director (Claude) — not used yet ---
# ANTHROPIC_API_KEY=
