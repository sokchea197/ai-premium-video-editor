# Server
PORT=8787
HOST=0.0.0.0
# Where projects, uploads and exports are stored (default: ./data)
# DATA_DIR=/var/lib/premium-studio
MAX_UPLOAD_MB=4096
# Concurrent FFmpeg jobs. Rendering is CPU-bound; 1 is right for most machines.
RENDER_CONCURRENCY=1
# x264 speed/quality trade-off: ultrafast … medium (default) … slow
X264_PRESET=medium
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# --- Not used yet. Planned for later stages (see README) ---
# Stage 3 · AI director (Claude)
# ANTHROPIC_API_KEY=
# Stage 2 · Speech-to-text (one provider)
# DEEPGRAM_API_KEY=
# OPENAI_API_KEY=
